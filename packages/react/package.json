{
  "name": "@newtalaria/react",
  "version": "0.2.1",
  "description": "Talaria SDK for React — ErrorBoundary, Profiler, and optional React Router instrumentation",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=test/dist --external:react --external:react-dom && node --test test/dist/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@newtalaria/browser": "^0.2.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-router": "^6.0.0 || ^7.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-router": { "optional": true },
    "react-router-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "talaria",
    "react",
    "error-tracking",
    "tracing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newtalaria/talaria-js-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://www.newtalaria.com/docs/sdk/react",
  "bugs": {
    "url": "https://github.com/newtalaria/talaria-js-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
