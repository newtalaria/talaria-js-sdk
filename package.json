{
  "name": "@newtalaria/js-sdk",
  "private": true,
  "description": "Talaria JavaScript SDK monorepo — @newtalaria/browser, core, node, react, nextjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newtalaria/talaria-js-sdk.git"
  },
  "homepage": "https://github.com/newtalaria/talaria-js-sdk",
  "bugs": {
    "url": "https://github.com/newtalaria/talaria-js-sdk/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm run test -w @newtalaria/core",
    "test:browser": "npm run test -w @newtalaria/browser",
    "test:node": "npm run test -w @newtalaria/node",
    "test:react": "npm run test -w @newtalaria/react",
    "test:nextjs": "npm run test -w @newtalaria/nextjs",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=18"
  }
}
