# Vite exposes only VITE_ variables. Only these names may use that prefix:
# TALARIA_URL, TALARIA_BROWSER_API_KEY, TALARIA_RELEASE, TALARIA_COMMIT_SHA.
# Omit the URL to use https://ingest-<cell>.newtalaria.com from the tal_pk_ key.
# VITE_TALARIA_URL=
VITE_TALARIA_BROWSER_API_KEY=
# VITE_TALARIA_RELEASE=
# VITE_TALARIA_COMMIT_SHA=

# Never set VITE_TALARIA_API_KEY, VITE_TALARIA_RELEASE_KEY, or VITE_TALARIA_MONITOR_TOKEN.
