# Browser client (instrumentation-client.ts).
# NEXT_PUBLIC_ is a Next.js rule. Only these names may use it:
# TALARIA_URL, TALARIA_BROWSER_API_KEY, TALARIA_RELEASE, TALARIA_COMMIT_SHA.
# Omit the URL to use https://ingest-<cell>.newtalaria.com from the key.
# NEXT_PUBLIC_TALARIA_URL=
NEXT_PUBLIC_TALARIA_BROWSER_API_KEY=
# NEXT_PUBLIC_TALARIA_RELEASE=
# NEXT_PUBLIC_TALARIA_COMMIT_SHA=

# Server / edge (talaria.server.config.ts, talaria.edge.config.ts).
# Never prefix TALARIA_API_KEY or TALARIA_RELEASE_KEY with NEXT_PUBLIC_.
# TALARIA_URL=
TALARIA_API_KEY=
# TALARIA_RELEASE_KEY=
