# Browser client (instrumentation-client.ts)
# Use NEXT_PUBLIC_ prefix per Next.js framework rules
NEXT_PUBLIC_TALARIA_URL=https://ingest.newtalaria.com
NEXT_PUBLIC_TALARIA_BROWSER_API_KEY=
# Optional: NEXT_PUBLIC_TALARIA_RELEASE=

# Server / edge (talaria.server.config.ts, talaria.edge.config.ts)
# Never expose these with NEXT_PUBLIC_ prefix
TALARIA_URL=https://ingest.newtalaria.com
TALARIA_API_KEY=
# TALARIA_RELEASE_KEY= (for releases:write, never public)
